# Godot import cache (regenerate with: tools/Godot.exe --headless --path . --import)
.godot/

# Engine binaries, export templates and local toolchains (large, not source)
godot/tools/Godot.exe
godot/tools/Godot.app/
godot/tools/_sc_
godot/tools/editor_data/
godot/tools/windows_*.exe
godot/tools/macos.zip
godot/tools/python-packages/

# Build outputs (legal notices and PLAY.txt beside the exe are kept)
godot/build/*.exe
godot/build/*.zip
godot/build/*.log
godot/build/macos/
godot/build/legacy/

# Generated test evidence: screenshots, logs, result JSON, capture rounds
godot/tests/*.png
godot/tests/*.png.import
godot/tests/*.log
godot/tests/*.json
godot/tests/logs/
godot/tests/compare/
godot/tests/ps2-forward/
godot/tests/ps2-gl/
godot/tests/showcase/
godot/tests/audio-study/
godot/*.log

# Oversized generated proving-ground bake; regenerate from godot/trackgen/proving_ground.gd
godot/tracks3d/proving_ground/proving_ground.scn

# Copyrighted reference screenshots, study-only, never distributed
godot/reference/

# OS / editor noise
.DS_Store
Thumbs.db
*.tmp
__pycache__/
# Spa bake (11 MB): regenerate from godot/trackgen/spa.gd; the dev drive scene caches it in user://tracks3d/
godot/tracks3d/spa/spa.scn
# Spa polish caches (rebuilt by trackgen/data/spa/fetch_sections.py and fetch_ortho.py)
godot/trackgen/data/spa/raw-lidar/xsec/
godot/trackgen/data/spa/ortho-cache/

# Nordschleife Section 1 bake and raw DGM1 downloads; regenerate from godot/trackgen/nordschleife_s1.gd
godot/tracks3d/nordschleife_s1/nordschleife_s1.scn
godot/trackgen/data/nordschleife/raw-dgm1/
